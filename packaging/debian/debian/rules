#!/usr/bin/make -f

# no LTO, as in the Arch package
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
# dh runs "ninja test", which shows a failing test's output only with this
export CTEST_OUTPUT_ON_FAILURE = 1

%:
	dh $@ --buildsystem=cmake+ninja

# where Debian's thunar-archive-plugin looks for .tap scripts
override_dh_auto_configure:
	dh_auto_configure -- -DTHUNAR_ARCHIVE_PLUGIN_DIR=/usr/libexec/thunar-archive-plugin
